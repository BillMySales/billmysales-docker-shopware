# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=shopware

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST is REQUIRED with it (no default).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the store (the storefront follows it on every `up`).
SW_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED)
# ---------------------------------------------------------------------------
# openssl rand -hex 32
APP_SECRET=
# openssl rand -hex 16 (identifies this installation; keep it stable)
INSTANCE_ID=
# The DB password goes into a URL: use hex (openssl rand -hex 24).
DB_PASSWORD=
DB_ROOT_PASSWORD=
# SW_ADMIN_* are only used by the installer: changing them later in .env
# doesn't change the account (do it in the administration).
SW_ADMIN_PASSWORD=
SW_ADMIN_EMAIL=
#SW_ADMIN_USER=admin
#DB_NAME=shopware
#DB_USER=shopware

# ---------------------------------------------------------------------------
# Store (used by the installer / initial settings, only on the first install)
# ---------------------------------------------------------------------------
#SW_SHOP_NAME=Shopware
# Default language: en-GB or de-DE (other languages need a language pack plugin).
#SW_LOCALE=en-GB
#SW_CURRENCY=CLP

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Shopware version: changing it and running `docker compose up -d --build`
# upgrades Shopware (new image, migrations by `setup`). Back up first.
#SW_VERSION=6.7.14.2
#PHP_VERSION=8.5
# Image name for the built Shopware image.
#SW_IMAGE=shopware-frankenphp
#CADDY_VERSION=2.11
#MARIADB_VERSION=12.3
#MAILPIT_VERSION=v1.31
# Mailpit web UI port (development only, profile "mailpit").
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Shopware / PHP
# ---------------------------------------------------------------------------
# Show PHP errors in the browser: Off in production (errors go to the logs).
#PHP_DISPLAY_ERRORS=Off
# Log level for docker compose logs: debug, info, notice, warning, error.
#LOG_LEVEL=warning
# Shopware's HTTP cache (1 = on).
#SW_HTTP_CACHE=1
#PHP_MEMORY_LIMIT=512m
#PHP_MAX_EXECUTION_TIME=300
# Max upload/request size (PHP and Caddy).
#UPLOAD_MAX_SIZE=64M
# Queue worker: restart after N seconds / when using this much memory.
#WORKER_TIME_LIMIT=300
#WORKER_MEMORY_LIMIT=384M

# ---------------------------------------------------------------------------
# Mail (SMTP), recommended: without SMTP_HOST no emails are sent (the image
# has no local mail server). When SMTP_HOST is set, these values replace the
# mailer settings of the administration on every `up`.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS), ssl (implicit TLS) or none (no encryption).
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Shop email address (sender of the shop's emails).
#SMTP_FROM=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#SW_MEMORY_LIMIT=1g
#WORKER_CONTAINER_MEMORY_LIMIT=512m
#SCHEDULER_MEMORY_LIMIT=384m
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
