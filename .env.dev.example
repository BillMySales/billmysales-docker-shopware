# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8105.
SW_URL=http://localhost:8105
SITE_ADDRESS=:80
HTTP_PORT=8105
HTTPS_PORT=8405
MAILPIT_PORT=8025

# Show PHP errors in the browser and log notices (never in production).
PHP_DISPLAY_ERRORS=On
LOG_LEVEL=notice

# Dev-only secrets and credentials.
APP_SECRET=dev-app-secret-not-for-production-0000000000000000
INSTANCE_ID=devinstance0000000000000000000000
DB_PASSWORD=shopware
DB_ROOT_PASSWORD=root
SW_ADMIN_USER=admin
SW_ADMIN_PASSWORD=admin12345
SW_ADMIN_EMAIL=admin@example.com

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com

# Optional overrides (see overrides/*.yaml), combined with ":".
#COMPOSE_FILE=compose.yaml:overrides/plugin.yaml
#PLUGIN_PATH=../billmysales-plugin-shopware
#PLUGIN_NAME=BillMySales
